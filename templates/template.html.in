<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
$if(description)$
  <meta name="description" content="$description$">
$endif$
  <link rel="icon" type="image/png" href="$if(root)$$root$$endif$assets/favicon.png" sizes="192x192">
  <link rel="alternate" type="application/rss+xml" title="sighook.im notes" href="$if(root)$$root$$endif$feed.xml">
  <title>$title$</title>
  <link rel="stylesheet" href="$if(root)$$root$$endif$assets/style.css">
</head>
<body$if(page-class)$ class="$page-class$"$endif$>
  <a class="skip-link" href="#content">Skip to content</a>
  <header>
    <a class="site-title" href="$if(root)$$root$$endif$index.html">sighook.im</a>
    <nav aria-label="Primary">
      <a href="$if(root)$$root$$endif$research.html">Research</a>
      <a href="$if(root)$$root$$endif$projects.html">Projects</a>
      <a href="$if(root)$$root$$endif$notes.html">Notes</a>
      <a href="$if(root)$$root$$endif$about.html">About</a>
      <a href="$if(root)$$root$$endif$cv.html">CV</a>
    </nav>
  </header>

  <main id="content">
$if(note)$
    <p class="note-meta"><time datetime="$date$">$date$</time> · <a href="$root$notes.html">All notes</a></p>
$endif$
$if(pdf-link)$
    <p class="document-link"><a href="$pdf-link$"$if(pdf-download-name)$ download="$pdf-download-name$"$endif$>Download PDF</a></p>
$endif$
    $body$
  </main>

  <footer>
    <p>© 2026 Alexandr Savca ·
      <a href="mailto:alexandr.savca89@gmail.com">Email</a> ·
      <a href="https://github.com/sighook">GitHub</a> ·
      <a href="https://linkedin.com/in/alexandr-savca89">LinkedIn</a> ·
      <a href="$if(root)$$root$$endif$key.html">PGP</a> ·
      <a href="$if(root)$$root$$endif$feed.xml">RSS</a>
    </p>
  </footer>
</body>
</html>
